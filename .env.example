# ===========================================
# ORIKZOR V2 — Environment Variables
# ===========================================
# Bu faylni `.env` ga ko'chiring va qiymatlarni o'zgartiring
# .env GIT'ga commit qilinmasin!

# ============ POSTGRESQL ============
POSTGRES_DB=orikzor
POSTGRES_USER=orikzor
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_PORT=5432

# ============ REDIS ============
REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379

# ============ BACKEND ============
BACKEND_PORT=8000

# JWT — uzun random string (`openssl rand -hex 32` bilan yarating)
JWT_SECRET_KEY=replace_with_64_char_random_string_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ENVIRONMENT=development

# Google Sheets URL (yerto'la magazinlari uchun)
SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRqe6q6h5fT2Mgev8JWFMgh430bEBKrxTA6AMqb3w8Ivnx2KZu95nqur6dEkoo1SuEL-0doS-fw9fh_/pub?output=csv

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://orikzor.betasoft.uz

# ============ FRONTEND ============
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api

# ============ NGINX (production) ============
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============ ADMIN ============
# Boshlang'ich admin foydalanuvchi (migration paytida yaratiladi)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=!@#$Orikzor_2026
INITIAL_USER_USERNAME=orikzor
INITIAL_USER_PASSWORD=Orikzor_2026
