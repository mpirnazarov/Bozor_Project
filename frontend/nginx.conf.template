server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Xarita rasmi 1 MB dan katta bo'lishi mumkin — nginx sukut bo'yicha
    # 1 MB da to'xtatib, backendga yetkazmasdan 413 qaytarardi.
    # Backend chegarasi 8 MB (maps.py: MAX_IMAGE_BYTES).
    client_max_body_size 10m;

    # API so'rovlarini backend'ga uzatish (same-domain -> Safari cookie ishlaydi)
    location /api/ {
        # Runtime DNS resolver (Railway external domen uchun)
        resolver 8.8.8.8 1.1.1.1 valid=30s;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # SPA — barcha yo'llar index.html ga
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
