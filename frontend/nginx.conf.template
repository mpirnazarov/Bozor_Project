server {
    listen ${PORT};
    client_max_body_size 50M;  # xarita rasmlari uchun
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # API so'rovlarini backend'ga uzatish (same-domain -> Safari cookie ishlaydi)
    location /api/ {
        # Runtime DNS resolver (Railway external domen uchun)
        resolver 8.8.8.8 1.1.1.1 valid=30s;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $http_cookie;
    }

    # /map.jpg — backend dan olish (deploy qilganda yo'qolmasin)
    location = /map.jpg {
        resolver 8.8.8.8 1.1.1.1 valid=30s;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend/api/maps/legacy-map;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header Cookie $http_cookie;
        expires 1h;
        add_header Cache-Control "public";
    }

    # Vite HMR WebSocket va dev-only endpointlarni bloklash (production)
    location /@vite/ { return 404; }
    location /node_modules/ { return 404; }

    # SPA — barcha yo'llar index.html ga
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
